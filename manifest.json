{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "1.4.0",
  "description": "Find and save videos, audio and playlists with Video Grabber and Media Scanner. Supports MP4, WebM and HLS streams.",
  "homepage_url": "https://github.com/lolizei/Video-grabber",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/dom-scan.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Grabber",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
